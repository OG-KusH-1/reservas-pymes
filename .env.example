# ==============================================================================
# Variables de entorno de ejemplo (sin secretos reales)
#
# Copia este archivo a `.env` en la raíz del monorepo:  cp .env.example .env
# La API valida estas variables al arrancar (apps/api/src/config/env.ts) y se
# niega a iniciar si falta alguna obligatoria o tiene un valor inválido.
# Toda variable nueva debe agregarse aquí con un valor ficticio y su comentario.
# ==============================================================================

# Entorno de ejecución: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL (docker compose)
# ------------------------------------------------------------------------------
# Credenciales con las que docker compose crea la base de datos local.
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda_dev
POSTGRES_DB=agenda
# Puerto publicado en tu máquina. Cámbialo si ya tienes un PostgreSQL en 5432.
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# API (apps/api)
# ------------------------------------------------------------------------------
# Puerto en que escucha la API.
PORT=4000
# Nivel de registro: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Cadena de conexión que usa la API. Debe coincidir con las credenciales de arriba.
DATABASE_URL=postgresql://agenda:agenda_dev@localhost:5432/agenda
# Conexiones máximas del pool por proceso de la API.
DATABASE_POOL_MAX=10
# URL pública de la web: origen permitido de CORS y base de los enlaces en correos.
WEB_URL=http://localhost:3000
# Proxies de confianza delante de la API: 1 = solo la web o solo un balanceador;
# suma uno por cada salto adicional. Un valor mayor al real permite falsificar la IP.
TRUST_PROXY=1
# Redis para las colas de trabajos en segundo plano.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Días de vigencia de una sesión del panel sin actividad.
SESSION_TTL_DIAS=30
# Límite global de peticiones por IP: THROTTLE_LIMITE cada THROTTLE_TTL_SEGUNDOS.
THROTTLE_TTL_SEGUNDOS=60
THROTTLE_LIMITE=120

# ------------------------------------------------------------------------------
# Correo (SMTP). En desarrollo apunta a Mailpit; interfaz en http://localhost:8025
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
# Usuario y contraseña del proveedor SMTP. Vacíos con Mailpit.
SMTP_USER=
SMTP_PASSWORD=
# true = TLS implícito (puerto 465). Con STARTTLS (587) o Mailpit, false.
SMTP_SECURE=false
# Remitente de los correos del sistema.
MAIL_FROM=Agenda <no-responder@agenda.local>
# Puerto de la interfaz web de Mailpit.
MAILPIT_UI_PORT=8025

# ------------------------------------------------------------------------------
# Web (apps/web)
# ------------------------------------------------------------------------------
# URL interna de la API. La web reenvía /api/* a esta dirección (mismo origen
# para el navegador) y la usa en el renderizado del lado del servidor.
API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# Datos de demostración (pnpm db:seed)
# ------------------------------------------------------------------------------
# Contraseña del usuario demo. Solo para desarrollo local.
SEED_PASSWORD=demo-agenda-2026
