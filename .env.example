# ==============================================================================
# Variables de Entorno de Ejemplo (Sin secretos reales)
# Copia este archivo a .env antes de iniciar el proyecto localmente.
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development

# Base de Datos (PostgreSQL 17 en Docker o local)
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_password
POSTGRES_DB=portfolio_reservas
POSTGRES_PORT=5432
DATABASE_URL=postgresql://portfolio_user:portfolio_password@localhost:5432/portfolio_reservas

# Backend - NestJS (apps/api)
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Frontend - Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT_WEB=3000
