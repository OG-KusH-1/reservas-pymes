# Estilo base compartido por cualquier editor. Prettier es la fuente de verdad
# del formato; este archivo evita diferencias antes de que Prettier actúe.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
