{
  "name": "reservas-portfolio-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @portfolio/api dev",
    "dev:web": "pnpm --filter @portfolio/web dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "test": "pnpm --recursive --filter \"./apps/*\" test",
    "lint": "pnpm --recursive --filter \"./apps/*\" lint",
    "db:generate": "pnpm --filter @portfolio/api db:generate",
    "db:migrate": "pnpm --filter @portfolio/api db:migrate",
    "db:seed": "pnpm --filter @portfolio/api db:seed"
  },
  "packageManager": "pnpm@12.18.0"
}
